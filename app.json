{
	"name": "smart-resume-matcher",
	"description": "AI-Powered Resume Tailoring for Job Applications",
	"scripts": {},
	"healthchecks": {
		"web": [
			{
				"type": "startup",
				"name": "check-web",
				"path": "/",
				"timeout": 5,
				"wait": 5,
				"attempts": 6
			}
		]
	},
	"env": {
		"NODE_ENV": {
			"value": "production"
		},
		"DATABASE_TYPE": {
			"value": "sqlite"
		},
		"DATABASE_PATH": {
			"value": "/app/data/sqlite.db"
		}
	}
}
