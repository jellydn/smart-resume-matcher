{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"packageRules": [
		{
			"matchUpdateTypes": [
				"patch",
				"minor",
				"digest",
				"pin",
				"lockFileMaintenance"
			],
			"automerge": true,
			"platformAutomerge": true
		},
		{
			"matchUpdateTypes": ["major"],
			"automerge": false
		}
	]
}
